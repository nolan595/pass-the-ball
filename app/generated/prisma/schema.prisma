generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Market {
  id               Int         @id @default(autoincrement())
  name             String
  marketId         Int         @unique
  displayType      DisplayType
  enabled          Boolean     @default(true)
  createdAt        DateTime    @default(now())
  superSubEligible Boolean     @default(false)

  @@map("markets")
}

model ExternalEvent {
  id              Int       @id @default(autoincrement())
  name            String
  externalEventId String    @unique
  matchDate       DateTime?
  createdAt       DateTime  @default(now())
  games           Game[]

  @@map("external_events")
}

model Game {
  id            Int              @id @default(autoincrement())
  name          String
  eventId       Int
  status        GameStatus       @default(DRAFT)
  openTime      DateTime
  closeTime     DateTime
  prizeType     PrizeType
  bonusId       String?
  multiplier    Float            @default(1.0)
  s3Status      String?
  paymentStatus String?
  createdAt     DateTime         @default(now())
  sgaPrice      Float?
  sgaStatus     String?
  sgaUuid       String?
  event         ExternalEvent    @relation(fields: [eventId], references: [id])
  picks         Pick[]
  groupPrices   GameGroupPrice[]

  @@map("games")
}

model Group {
  id         Int              @id @default(autoincrement())
  name       String
  slug       String           @unique
  createdAt  DateTime         @default(now())
  players    Player[]
  gamePrices GameGroupPrice[]

  @@map("groups")
}

model GameGroupPrice {
  id        Int      @id @default(autoincrement())
  gameId    Int
  groupId   Int
  price     Float?
  sgaUuid   String?
  sgaStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([gameId, groupId])
  @@map("game_group_prices")
}

model Player {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  displayName String
  groupId     Int?
  createdAt   DateTime @default(now())
  group       Group?   @relation(fields: [groupId], references: [id])
  picks       Pick[]

  @@map("players")
}

model Pick {
  id         Int      @id @default(autoincrement())
  gameId     Int
  playerId   Int
  marketId   Int
  oddUuid    String
  oddName    String
  marketName String
  oddPrice   Float
  createdAt  DateTime @default(now())
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@map("picks")
}

enum DisplayType {
  ONE_X_TWO
  OVER_UNDER
  ONE_FROM_TWO
  PLAYER_PROPS
  PLAYER_PROPS_SINGLE
}

enum GameStatus {
  DRAFT
  PENDING
  OPEN
  CLOSED
  COMPLETED
}

enum PrizeType {
  CASH
  FREE_BET
}
